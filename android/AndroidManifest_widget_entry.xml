<!--
  INT-2 — the manifest entry that registers the home-screen widget.
  The build merges this block into
  android/app/src/main/AndroidManifest.xml, immediately before </application>.

  It contains ONLY the <receiver>. An <intent-filter> may NOT be a direct child
  of <application> — AAPT rejects it with
  "unexpected element <intent-filter> found in <manifest><application>".
  So the widget's deep-link scheme (shelf://...) is declared INSIDE MainActivity
  in the manifest itself, not here.

  The appwidget-provider metadata points at res/xml/shelf_widget_info.xml
  (minWidth/minHeight 110dp, updatePeriodMillis 1800000 = 30 minutes, matching
  WIDGET_REFRESH_MIN).
-->

<receiver
    android:name=".ShelfWidgetProvider"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/shelf_widget_info" />
</receiver>
